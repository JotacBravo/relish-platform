# Copy to relish/.env before `npm start` or `npm run build`. All optional.

# Prolific completion codes (used only by the *_prolific survey addresses).
REACT_APP_PROLIFIC_CODE_YOUTH=
REACT_APP_PROLIFIC_CODE_FUTURES=
REACT_APP_PROLIFIC_CODE_VISIONS=

# `npm run serve` reads PORT (3000), HOST (127.0.0.1) and API_URL
# (http://127.0.0.1:5000) from the shell.
