# Environment for the processing scripts. The scripts read these variables from
# the environment (they do not load this file): export them, or use
#   set -a; . processing/.env; set +a
# Defaults are given in the comments; leave a value empty to use the default.

# Anthropic API, for the normalisation and the story cards.
ANTHROPIC_API_KEY=
# Gemini, for generate_dish_icons.py and generate_ingredient_icons.py.
GEMINI_API_KEY=
# Service-account JSON key file for Vertex AI Imagen (story images, menu icons).
GOOGLE_APPLICATION_CREDENTIALS=
# Imagen model and region (default: imagen-3.0-generate-002, us-central1).
IMAGEN_MODEL=
IMAGEN_LOCATION=

# Where the scripts read the survey answers (default: http://127.0.0.1:5000,
# the API started with `npm run demo` or `npm start` in server/backend).
RELISH_API_URL=
# Folder with the tables and cards the scripts read and write (default:
# processing/output). Point it to STATIC_DATA_DIR/data to update what the API serves.
RELISH_DATA_DIR=
# Story illustrations: full-size masters and web-sized copies (defaults:
# processing/output/images/story_cards and processing/output/images/story_cards_web).
STORY_IMAGES_DIR=
STORY_IMAGES_WEB_DIR=
# Icon folders (defaults: relish/public/icons/dishes, .../ingredients, .../dishes_v2).
DISH_ICONS_DIR=
INGREDIENT_ICONS_DIR=
MENU_ICONS_DIR=

# Path to NRC-Emotion-Lexicon-Wordlevel-v0.92.txt (not included; see processing/README.md).
NRC_LEXICON_PATH=

# process_new_stories.sh: Python interpreter and log file
# (defaults: python3, processing/output/story_pipeline.log).
PYTHON=
LOG_FILE=
