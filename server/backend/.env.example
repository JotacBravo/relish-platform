# Copy to server/backend/.env. All values are optional.

# MongoDB (not used by `npm run demo`, which starts its own).
MONGO_URL=mongodb://127.0.0.1:27017/relish

# API address.
PORT=5000
HOST=127.0.0.1

# Browser origins allowed by CORS (comma-separated).
ALLOWED_ORIGINS=http://localhost:3000

# Bearer token for the admin routes; empty keeps them closed (openssl rand -hex 32).
ADMIN_API_TOKEN=

# false: do not store S2 swipes.
LIKES_ENABLED=true

# Leave out of the public feed the responses created before this ISO date.
COLLECTION_START=

# Number of reverse proxies in front of the API (empty when none).
TRUST_PROXY=

# production on a public server.
NODE_ENV=

# Static files served under /data and /images (default: ../../dummy-data/static).
STATIC_DATA_DIR=

# Responses loaded by `npm run demo` and `npm run seed` (default: ../../dummy-data/responses).
DUMMY_RESPONSES_DIR=

# Key of the IP hash stored with telemetry; random per start if empty (openssl rand -hex 32).
LOG_IP_SALT=

# Free-text normaliser: off without a key.
ANTHROPIC_API_KEY=
# 1: off even with a key (`npm run demo` keeps it off unless 0).
NORMALIZER_DISABLED=
# Where the tables are written (default: STATIC_DATA_DIR/data).
NORMALIZER_OUTPUT_DIR=
# Webhook (Slack, Discord, ntfy, ...) for normaliser alerts.
NORMALIZER_ALERT_WEBHOOK=
# Gemini key: an icon for each new everyday dish.
GEMINI_API_KEY=
# Where those icons go (default: ../../relish/public/icons/dishes).
DISH_ICONS_DIR=
